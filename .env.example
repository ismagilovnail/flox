# FLOX environment variables
# Copy to .env and fill in real values. Never commit .env.
# This file tracks the FULL planned surface (§7, §17, §33) even though most
# of these are not consumed yet — services land phase by phase per ROADMAP.md.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
TRACKER_URL=http://localhost:8081
WORKER_URL=http://localhost:8082
LOG_LEVEL=info

# --- PostgreSQL (control plane) ---
DATABASE_URL=postgres://flox:flox@localhost:5432/flox?sslmode=disable

# --- ClickHouse (events + analytics) ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=flox
CLICKHOUSE_USER=flox
CLICKHOUSE_PASSWORD=

# --- Redis (cache, rate limits, sticky cache, postback dedup) ---
REDIS_URL=redis://localhost:6379/0

# --- S3-compatible object storage ---
# Access key/secret below are infra/docker-compose.dev.yml's MinIO root
# credentials — throwaway local-dev values, not real secrets. Replace both
# for staging/production.
S3_ENDPOINT=http://localhost:9000
# What a browser resolves presigned Content Gallery download URLs against —
# same as S3_ENDPOINT when running apps/api directly on the host (this
# default). infra/docker-compose.dev.yml/test.yml override S3_ENDPOINT to
# an in-network container name apps/api uses internally, and set this
# separately to the host-published port a browser can actually reach.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=flox
S3_ACCESS_KEY_ID=flox-minio-admin
S3_SECRET_ACCESS_KEY=flox-minio-secret

# --- Auth / sessions (§52, Phase 28A) ---
# No secret to configure: session/invite tokens are random (crypto/rand),
# never signed or encrypted, and stored hashed (SHA-256) — there is no
# JWT and nothing here needs a signing key. See docs/auth.md.

# --- SMTP / email ---
# apps/internal/mailer sends the signup email-verification link over this.
# Dev: infra/docker-compose.dev.yml's mailhog service catches whatever is
# sent here instead of actually delivering it; web UI at
# http://localhost:8025. Production: a real relay (SES SMTP, Postmark,
# Sendgrid, a corporate relay, ...) — put credentials in the URL
# (smtp://user:pass@host:port) if it requires auth. Team invites still use
# a copyable link, not a real email (see apps/internal/auth/model.go) —
# that's unrelated to this and stays that way.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=FLOX <no-reply@floxlink.io>

# --- Security (§30, real 2FA) ---
# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`) — AES-256-GCM
# key apps/internal/totp uses to encrypt a user's TOTP secret at rest
# (users.totp_secret). Generate a real one per environment; never reuse the
# dev value below in staging/production, and never commit a real one.
TOTP_ENCRYPTION_KEY=IXkldrBTvgfDhIxzUBn3MrRAJq7Gh7z8mQ5UhBC4DRo=

# --- Integrations (§30, Settings > Integrations credentials) ---
# Same shape as TOTP_ENCRYPTION_KEY (32 raw bytes, base64-encoded,
# AES-256-GCM) but a deliberately separate key — used by apps/internal/
# integrations to encrypt Namecheap/Cloudflare/Slack credentials at rest.
# Generate a real one per environment; never reuse the dev value below in
# staging/production, and never commit a real one.
INTEGRATION_ENCRYPTION_KEY=wLE0wIEHBNnfVfq8d62JDEAltM4frTgYmPi8XAv1QpY=

# --- Ad account connections (§74/§27-COST, Google Ads) ---
# Same shape again (32 raw bytes, base64-encoded, AES-256-GCM) but its
# own deliberately separate key — used by apps/internal/adaccount to
# encrypt Google Ads' developer token/client secret/refresh token at
# rest. Needed by both apps/api and apps/worker. Generate a real one per
# environment; never reuse the dev value below in staging/production,
# and never commit a real one.
ADACCOUNT_ENCRYPTION_KEY=KatbgYl+Kd4KPI5T0hKfwZRYsij/t7g7fVomXdjhW/c=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=flox

# --- FX rates (§50-FX) ---
# No env var: rates are read from the `fx_rates` Postgres table, looked up
# at each event's own date (never time.Now()). Nothing in this repo fetches
# them from an external provider yet, so there is no API key to configure —
# rows are loaded into that table out of band. A real provider client would
# add its own key here when one is built.

# --- Geo/ASN provider (apps/internal/classifier/maxmind) ---
# Local .mmdb file paths — either MaxMind GeoLite2 (free account + license
# key required) or DB-IP Lite (CC BY 4.0, no registration) work unmodified;
# docs/geoip.md has both. Both empty (the default) — apps/tracker falls
# back to NoopGeoProvider/NoopASNProvider, i.e. country/city/asn stay
# empty rather than fabricated.
GEOIP_CITY_DB_PATH=
GEOIP_ASN_DB_PATH=

# --- Trusted proxies (apps/internal/clientip, security audit finding #2) ---
# Comma-separated CIDR blocks or bare IPs for whatever sits directly in
# front of apps/api and apps/tracker (a load balancer, CDN, or ingress
# sidecar) — X-Forwarded-For is only trusted from these peers, so leave
# this empty until a real one is deployed. Empty (the default) falls back
# to loopback + the RFC 1918/4193 private ranges, which is a safe no-op
# for a deployment with nothing in front of it yet: a public peer address
# is never in that set, so a spoofed header from the open internet is
# still ignored. Set to the literal value "none" to disable
# X-Forwarded-For entirely (RemoteAddr always wins) for a deployment with
# no proxy at all, even a private one.
TRUSTED_PROXIES=

# --- Domain / DNS automation (§30/§74) ---
# Real Namecheap/Cloudflare credentials are per-org, stored encrypted in
# Postgres via Settings > Integrations (INTEGRATION_ENCRYPTION_KEY, above)
# — not a global env var, since different orgs connect different accounts.
# This is the one genuinely global piece: the real, publicly-reachable
# hostname or IP this deployment's apps/tracker is served from. Used only
# by the DNS-record-sync action (apps/internal/domain/cloudflare) when
# creating/updating a domain's CNAME to point at FLOX. No default — this
# environment has nothing publicly deployed, and a plausible-looking fake
# value would silently point a real customer's domain at nothing;
# domain.Service.SyncDNS refuses with a clear error while this is empty.
TRACKER_DNS_TARGET=

# --- Ad-network cost import (§27-COST) ---
# Facebook/TikTok/Google Ads all use a real per-traffic-source manual-
# credential connection instead (apps/internal/adaccount) — no registered
# OAuth app exists in this environment, so there's no app id/secret pair
# to configure globally. See docs/ad-account-connections.md.
