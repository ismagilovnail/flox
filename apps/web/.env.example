# apps/web environment variables (Phase 27).
# Copy to .env.local (Next.js's own convention) and fill in real values.
# Never commit .env.local.

# Where apps/api is running. Matches the root .env.example's API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# There is no authentication yet (Phase 28) — apps/internal/tenant derives
# organization_id from an X-Organization-Id header, and this is where the
# frontend gets the value to send. Set it to a real, already-existing
# organization id (see apps/api/migrations for the `organizations` table;
# nothing seeds one automatically yet). Every page that calls a real API
# will show a clear error until this is set — see lib/api/client.ts's
# MissingDevOrgError.
NEXT_PUBLIC_DEV_ORG_ID=
