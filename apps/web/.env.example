# apps/web environment variables (Phase 27).
# Copy to .env.local (Next.js's own convention) and fill in real values.
# Never commit .env.local.

# Where apps/api is running. Matches the root .env.example's API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# No other setup needed (Phase 28B): auth is a real session cookie now —
# sign up at /signup (or accept an invite link) instead of setting an org
# id by hand. apps/internal/tenant derives organization_id from that
# cookie, not a client-supplied header.
