# Keys of the Secret `flox-secrets` (namespace flox). Copy to a file kept
# OUT of git, fill in, then:
#   kubectl -n flox create secret generic flox-secrets --from-env-file=secrets.env
# docs/environment.md explains each. Generate keys with: openssl rand -base64 32

# Required
DATABASE_URL=postgres://flox:CHANGE_ME@postgres.example.internal:5432/flox?sslmode=verify-full
# Signs sticky cookies; changing it re-buckets every returning visitor.
STICKY_COOKIE_KEY=

# Strongly recommended (a feature is off without it)
CLICKHOUSE_PASSWORD=
REDIS_URL=rediss://:CHANGE_ME@redis.example.internal:6380/0
# The in-cluster NATS (components/nats) requires a login: the same password
# in both. Hex or alphanumeric, as it sits in a URL (openssl rand -hex 24).
NATS_PASSWORD=
NATS_URL=nats://flox:SAME_AS_NATS_PASSWORD@nats:4222
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_URL=smtp://user:CHANGE_ME@smtp.example.com:587
LANDING_LINK_KEY=
TOTP_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=
ADACCOUNT_ENCRYPTION_KEY=

# Backups of ClickHouse and the files bucket (components/backup): the
# off-site bucket's keys.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Optional
SENTRY_DSN=
